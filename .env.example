# Copy to .env and fill in the password you set when creating the DBMS in Neo4j Desktop
NEO4J_URI=neo4j://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me
NEO4J_DATABASE=neo4j
# Port for the REST API (api/)
PORT=3000
# Optional: when set, every /api request must send header  x-api-key: <value>
API_KEY=
