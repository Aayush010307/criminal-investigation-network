# Copy to .env (never commit .env) and replace every placeholder.

# ---- Neo4j connection (the password you set for the DBMS / docker container)
NEO4J_URI=neo4j://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me
NEO4J_DATABASE=neo4j

# ---- API server
PORT=3000

# ---- Authentication
# Secret used to sign access tokens: at least 32 random characters, e.g.  openssl rand -hex 32
# If it is missing the API generates a random one at start-up (everyone is signed out on restart).
AUTH_SECRET=replace-with-output-of-openssl-rand-hex-32
# Access-token lifetime in hours
TOKEN_TTL_HOURS=8
# First administrator, created when the API starts if no user with this name exists (password >= 8 characters).
# Change the password here before the first start; afterwards the stored scrypt hash is used.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-too
